# Supabase project URL (public URL used by the browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key: safe for browser use when RLS is correctly configured
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-side Supabase URL and publishable key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional: privileged server-side operations only.
# Never expose this value to browser code or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=replace_me
